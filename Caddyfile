# Caddy configuration for E-Serbisyo local Split-Horizon DNS resolution.
# Update the hostnames (portal.brgy143.gov.ph / api.brgy143.gov.ph) to match your custom local domain names.

portal.brgy143.gov.ph {
    # Reverse proxy to the local Vite client frontend
    reverse_proxy localhost:5173

    # Direct Caddy to issue and trust local self-signed TLS certificates.
    # Note: On client devices, import Caddy's root CA certificate (root.crt)
    # to avoid browser SSL warnings and enable webcam permissions.
    tls internal
}

api.brgy143.gov.ph {
    # Reverse proxy to the local Express backend API
    reverse_proxy localhost:3000

    # Issue and trust local self-signed TLS certificates.
    tls internal
}
