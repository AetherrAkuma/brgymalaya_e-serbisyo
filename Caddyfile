# Frontend Proxy on Port 8080 (Any Hostname)
:8080 {
    reverse_proxy 127.0.0.1:5173
}

# Load-Balanced API Proxy on Port 8081 (Any Hostname)
:8081 {
    reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
        lb_policy round_robin
        health_uri /api/v1/health
        health_interval 5s
        health_timeout 2s
    }
}
